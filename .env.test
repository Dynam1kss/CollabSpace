# окрема база для тестів, щоб не займати дев-дані — піднімається тим самим postgres з docker-compose
NODE_ENV=test
DATABASE_URL=postgresql://collabspace:collabspace@localhost:5432/collabspace_test
JWT_SECRET=test-secret-only-for-vitest

# маленькі межі файлів: перевірки мають бути швидкі й точні, а не ганяти 50 МБ
FILE_MAX_BYTES=4096
BOARD_FILES_MAX_BYTES=10240
