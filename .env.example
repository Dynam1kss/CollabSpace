# Порт, на якому сервер застосунків обслуговує REST API та WebSocket
PORT=3000

# Рядок підключення до PostgreSQL (для Prisma, з'явиться разом зі схемою БД)
DATABASE_URL=postgresql://collabspace:collabspace@localhost:5432/collabspace

# Облікові дані PostgreSQL для docker-compose — мають збігатися з DATABASE_URL
POSTGRES_USER=collabspace
POSTGRES_PASSWORD=collabspace
POSTGRES_DB=collabspace

# Адреса Redis для стану присутності (з'явиться на етапі реального часу)
REDIS_URL=redis://localhost:6379

# Секрет для підпису JWT-токена авторизації — згенеруй свій, не використовуй цей у продакшені
JWT_SECRET=change-me-to-a-random-string

# ICE-сервери для spike/webrtc. STUN через кому, за замовчуванням публічний Google.
# TURN опційний — заповни всі три поля, щоб перевірити зʼєднання через мережі
# з CGNAT/симетричним NAT, де самого STUN не вистачає
ICE_STUN_URLS=stun:stun.l.google.com:19302
ICE_TURN_URL=
ICE_TURN_USERNAME=
ICE_TURN_CREDENTIAL=

# all (типово, прямі зʼєднання дозволені) або relay (лише через TURN — щоб
# перевірити сам TURN-сервер окремо від мережі, до висновків про CGNAT/NAT)
ICE_TRANSPORT_POLICY=all
