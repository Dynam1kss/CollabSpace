# Порт, на якому сервер застосунків обслуговує REST API та WebSocket
PORT=3000

# Рядок підключення до PostgreSQL для Prisma.
# connection_limit — розмір пулу зʼєднань. Без нього prisma бере
# «ядер * 2 + 1», і на машині з іншим числом ядер прогін вимірювань виходить
# різний; 20 — щоб під 50 клієнтами запит не чекав на вільне зʼєднання (P2024).
# pool_timeout — скільки секунд чекати на зʼєднання з пулу, перш ніж здатись.
# connect_timeout — скільки чекати на саме відкриття зʼєднання. Дефолтних 5с
# під прогоном на 50 клієнтах не вистачало: контрольна точка postgres у
# wsl2 займала диск на 30–70с, і новий коннект не встигав (P1001)
DATABASE_URL=postgresql://collabspace:collabspace@localhost:5432/collabspace?connection_limit=20&pool_timeout=20&connect_timeout=10

# Облікові дані PostgreSQL для docker-compose — мають збігатися з DATABASE_URL
POSTGRES_USER=collabspace
POSTGRES_PASSWORD=collabspace
POSTGRES_DB=collabspace

# Адреса Redis для стану присутності (з'явиться на етапі реального часу)
REDIS_URL=redis://localhost:6379

# Секрет для підпису JWT-токена авторизації — згенеруй свій, не використовуй цей у продакшені
JWT_SECRET=change-me-to-a-random-string

# ICE-сервери для spike/webrtc. STUN через кому, за замовчуванням публічний Google.
# TURN опційний — заповни всі три поля, щоб перевірити зʼєднання через мережі
# з CGNAT/симетричним NAT, де самого STUN не вистачає
ICE_STUN_URLS=stun:stun.l.google.com:19302
ICE_TURN_URL=
ICE_TURN_USERNAME=
ICE_TURN_CREDENTIAL=

# all (типово, прямі зʼєднання дозволені) або relay (лише через TURN — щоб
# перевірити сам TURN-сервер окремо від мережі, до висновків про CGNAT/NAT)
ICE_TRANSPORT_POLICY=all

# Пошта для відновлення пароля. У розробці — maildev з docker-compose:
# скринька відкривається на http://localhost:1080, логіна й пароля не треба.
# Порожній SMTP_HOST — лист друкується в консоль сервера; у продакшені сервер
# без нього не стартує
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CollabSpace <no-reply@collabspace.local>

# Адреса, з якою збирається посилання в листі — сама себе з запиту брати не
# можна, Host підробляється. У розробці це vite, у проді — домен застосунку
APP_URL=http://localhost:5173

# Якою стратегією синхронізації працюють кімнати цього сервера: per-event,
# batched або aoi (типово aoi). Вибирає сервер, а не браузер: канали вмісту в
# стратегій різні, тож двоє на різних режимах в одній кімнаті одне одного не
# чують. Стенд вимірювань переставляє це через /api/bench/strategy, яка
# відкривається лише з BENCH_METRICS=1
SYNC_STRATEGY=aoi

# Межа розміру одного файла, прикріпленого до дошки (байти). Типово 50 МБ.
# Це число сервер віддає клієнту в /api/health, і клієнт перевіряє розмір ще
# до завантаження; змінити межу — виправити тут і перезапустити сервер
FILE_MAX_BYTES=52428800

# Скільки всього байтів файлів дозволено одній дошці. Типово 500 МБ
BOARD_FILES_MAX_BYTES=524288000
