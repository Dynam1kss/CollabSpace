generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarColor  String
  createdAt    DateTime @default(now())

  ownedBoards   Board[]        @relation("BoardOwner")
  memberships   BoardMember[]
  chatMessages  ChatMessage[]
  assets        Asset[]
  refreshTokens RefreshToken[]
}

model Board {
  id        String   @id @default(cuid())
  title     String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User           @relation("BoardOwner", fields: [ownerId], references: [id])
  members      BoardMember[]
  snapshot     BoardSnapshot?
  chatMessages ChatMessage[]
  assets       Asset[]
}

// Роль користувача на конкретній дошці.
model BoardMember {
  boardId String
  userId  String
  role    Role

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

// Серіалізований Y.Doc дошки (розділ 6 docs/ТЗ.md). Персист з'явиться в
// етапі 3 — до того рядок створюється з порожнім Buffer при створенні дошки.
model BoardSnapshot {
  boardId   String   @id
  state     Bytes
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  boardId   String
  authorId  String
  text      String
  objectId  String?
  createdAt DateTime @default(now())

  board  Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])
}

model Asset {
  id         String @id @default(cuid())
  boardId    String
  path       String
  mimeType   String
  size       Int
  uploadedBy String

  board    Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploadedBy], references: [id])
}

// Поза розділом 5 docs/ТЗ.md — див. docs/DECISIONS.md ("Зберігання
// refresh-токенів"). Зберігаємо хеш токена, не сам токен.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
