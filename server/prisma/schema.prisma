generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ADMIN між власником і редактором: уміє все, що редактор, плюс роздає ролі
// й виганяє. Власник лишається один на дошку і рядка учасника не має
enum BoardRole {
  ADMIN
  EDITOR
  VIEWER
}

// запрошення на дошку чекає згоди: PENDING доступу не дає ніде, лише висить
// у списку запрошень того, кого кличуть
enum MemberStatus {
  PENDING
  ACCEPTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  displayName     String
  // відносний /uploads/avatars/... — як і картинки на дошках; null — буква замість фото
  avatarUrl       String?
  // рядок «про себе» під імʼям у картці профілю. 100 символів — стільки ж,
  // скільки в displayName, і рівно на два рядки картки завширшки 320px
  bio             String?
  // light | dark — рядком, як і роль у протоколі; перевіряє zod на вході
  theme           String    @default("light")
  // uk | en | de | fr — мова інтерфейсу; серверні тексти помилок від неї не залежать
  locale          String    @default("uk")
  // null — пошту ще не підтвердили. Доступу це НЕ обмежує: непідтверджений
  // акаунт уміє все, просто бачить нагадування, поки тут порожньо
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  ownedBoards   Board[]             @relation("BoardOwner")
  memberships   BoardMember[]
  chatMessages  ChatMessage[]
  seats         BoardSeat[]
  resetTokens   PasswordReset[]
  verifications EmailVerification[]
  uploadedFiles BoardFile[]
}

// відновлення пароля поштою. Тримаємо не сам токен, а його sha256: з бази,
// яка витекла, листа відновлення вже не зробиш. argon2 тут не годиться —
// рядок шукаємо ЗА хешем, а argon2 щоразу дає інший (своя сіль), і довелось
// би перебирати всю таблицю. Ентропії тут 256 біт, тобто те, від чого
// боронить argon2 (перебір короткого пароля), тут неможливе
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  // одноразовість: після використання рядок лишається, але вже не спрацює
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// підтвердження пошти при реєстрації. Окремою таблицею від PasswordReset,
// хоч поля ті самі: терміни різні (доба проти години), гасяться вони незалежно
// (зміна пароля не має скасовувати підтвердження й навпаки), а спільний
// tokenHash довелось би ще й розрізняти за видом у кожному запиті
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Board {
  id        String   @id @default(cuid())
  title     String
  ownerId   String
  owner     User     @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  BoardMember[]
  snapshot BoardSnapshot?
  cells    BoardSnapshotCell[]
  chat     ChatMessage[]
  seats    BoardSeat[]
  versions BoardVersion[]
  files    BoardFile[]
}

model BoardMember {
  id            String       @id @default(cuid())
  boardId       String
  board         Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          BoardRole
  // хто дав цю роль. Потрібне лише для адміністраторів: піднятого власником
  // знімає тільки власник, піднятого іншим адміністратором — будь-який
  // адміністратор. Без звʼязку й без каскаду: це слід, а не посилання —
  // коли той, хто роздавав, сам піде з дошки, слід має лишитись
  roleGrantedBy String?
  // дефолт PENDING навмисно: забули вказати — доступу нема, а не навпаки
  status        MemberStatus @default(PENDING)
  createdAt     DateTime     @default(now())

  @@unique([boardId, userId])
}

// чат дошки — на відміну від присутності, це не ефемерний стан: хто зайде
// завтра, має побачити розмову, а не порожнечу. Індекс саме парою — вибірка
// завжди «останні N цієї дошки»
model ChatMessage {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([boardId, createdAt])
}

// місце людини на дошці — «стілець», до якого вона сіла. Окрема таблиця, а
// не поле в BoardMember: у власника рядка учасника немає взагалі, а стілець
// потрібен і йому. Ключ — пара (дошка, людина), по одному місцю на дошку
model BoardSeat {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  updatedAt DateTime @updatedAt

  @@unique([boardId, userId])
}

// старий цілий знімок дошки. Лишився тільки для дошок, які ще жодного разу не
// зберігали після переходу на клітинки: перший же запис розкладає його по
// BoardSnapshotCell і прибирає цей рядок
// файл, прикріплений до дошки. На диску він лежить під випадковим імʼям
// (storageName), а те, як його назвала людина, — лише запис тут: у назві від
// користувача може бути що завгодно, і підставляти її у шлях не можна.
// Квота дошки — сума size цих рядків
model BoardFile {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  name        String
  // визначений за сигнатурою самого файла, а не за тим, що сказав клієнт
  mime        String
  size        Int
  storageName String
  createdAt   DateTime @default(now())

  @@index([boardId])
}

model BoardSnapshot {
  id        String   @id @default(cuid())
  boardId   String   @unique
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  state     Bytes
  updatedAt DateTime @updatedAt
}

// вміст дошки по клітинках сітки — окремий рядок на клітинку, а не один json
// на дошку. Двоє, що зберігають різні ділянки (звичайна річ у стратегії 3),
// пишуть тоді в РІЗНІ рядки, і зливати нічого не треба. Доти збереження читало
// весь знімок, підмішувало свої клітинки й писало назад — і той, хто прочитав
// раніше, а записав пізніше, стирав чуже щойно збережене
model BoardSnapshotCell {
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // ключ клітинки «ix:iy», той самий, що в shared/cells
  cell      String
  state     Bytes
  updatedAt DateTime @updatedAt

  @@id([boardId, cell])
}

// історія вмісту дошки — копії BoardSnapshot.state на певну мить. Автоматичні
// складає сам сервер під час збережень, ручні — власник чи адмін із підписом.
// createdBy — рядок без звʼязку, як roleGrantedBy: людина може піти з сервісу,
// а версія, яку вона зробила, лишитись має
model BoardVersion {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  state     Bytes
  createdAt DateTime @default(now())
  createdBy String
  label     String?
  isManual  Boolean

  @@index([boardId, createdAt])
}
